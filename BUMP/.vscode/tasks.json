{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Dev: Start All (Game + ArcEngine + Resources)",
      "type": "process",
      "command": "python3",
      "args": [
        "tools/dev_tasks.py",
        "dev-all"
      ],
      "windows": {
        "command": "python",
        "args": [
          "tools\\dev_tasks.py",
          "dev-all"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder:BUMP}"
      },
      "presentation": {
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "dev-all",
        "clear": true
      },
      "problemMatcher": []
    },
